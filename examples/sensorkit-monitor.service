[Unit]
Description=I2C bus auto-discover and prometheus monitor service.
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
Restart=always
User=pi
Group=pi
WorkingDirectory=/home/pi/.local/bin
ExecStart=/home/pi/venv/sm-service-main/bin/python /home/pi/.local/bin/sm-service/sensorkit-monitor.py --config /home/pi/.config/sensorkit-monitor/config.yaml
[Install]
WantedBy=multi-user.target
